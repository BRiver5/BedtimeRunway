{
  "expo": {
    "name": "Bedtime Runway",
    "slug": "bedtimerunway",
    "version": "1.0.0",
    "scheme": "bedtimerunway",
    "orientation": "portrait",
    "icon": "./release/creo/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./release/creo/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EFFD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bedtimerunway.app"
    },
    "android": {
      "package": "com.bedtimerunway.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./release/creo/adaptive-foreground.png",
        "backgroundColor": "#F2EFFD"
      },
      "predictiveBackGestureEnabled": false,
      "_comment_blockedPermissions": "Bedtime Runway полностью локальное и без уведомлений: заблокированы в том числе INTERNET и POST_NOTIFICATIONS. Нужна только вибрация (VIBRATE не блокируется).",
      "blockedPermissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.READ_CALL_LOG",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
